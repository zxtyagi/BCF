<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.BasicCashFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/night_blue</item>
        <item name="colorPrimaryDark">@color/night_blue_dark</item>
        <item name="backgroundColor">@color/night_blue_light</item>
        <item name="colorPrimaryVariant">@color/ash_blue</item>
        <item name="colorSecondary">@color/acqua_green</item>
        <item name="colorSecondaryVariant">@color/dark_green</item>
        <item name="colorOnPrimary">@color/acqua_green</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceInverse">@color/light_lavander</item>
        <item name="colorOnSurfaceInverse">@color/black</item>
        <item name="colorPrimaryInverse">@color/dark_green</item>
        <item name="colorOnSurfaceVariant">@color/ash_blue</item>
        <item name="colorSurfaceContainerLow">@color/night_blue_dark</item>

        <item name="android:colorBackground">?attr/backgroundColor</item>
        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>
        <item name="android:navigationBarColor">?attr/backgroundColor</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:textColorHint">@color/white_semitrans</item>
        <item name="materialAlertDialogTheme">@style/custom_dialog</item>
    </style>

    <style name="Theme.BasicCashFlow" parent="Base.Theme.BasicCashFlow" />
</resources>